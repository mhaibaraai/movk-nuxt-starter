{
  "name": "movk-nuxt-starter",
  "private": true,
  "description": "基于 Nuxt 4、Nuxt UI 与 Movk Nuxt 的最简启动模版",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate --envName spa",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "docker:build": "docker build -t movk-nuxt-starter .",
    "docker:prod": "docker run --rm -p 3000:3000 --env-file .env.production movk-nuxt-starter",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "clean": "movk-clean"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/simple-icons": "^1.2.100",
    "@movk/core": "^1.5.0",
    "@movk/nuxt": "^1.8.3",
    "@nuxt/ui": "^4.12.0",
    "nuxt": "^4.6.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.11.2"
}
